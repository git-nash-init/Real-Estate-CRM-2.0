# Supabase project (same project as the CRM). MUST be the service role key,
# not the publishable/anon key — the gateway needs to bypass RLS to read the
# outbox and manage its own auth-state row from a trusted server context.
# Get it from Supabase Dashboard > Project Settings > API > service_role.
# NEVER expose this key to the browser/frontend.
SUPABASE_URL=https://umuctbiofbyjwnqavxus.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required in the x-api-key header for /status, /qr, /send.
# Generate any random string. Leave blank only for local testing.
GATEWAY_API_KEY=

# Throttling (milliseconds / count) — see README for guidance before
# changing these. Defaults are conservative to reduce ban risk.
WA_MIN_GAP_MS=8000
WA_MAX_GAP_MS=15000
WA_DAILY_CAP=200
WA_POLL_INTERVAL_MS=5000

PORT=3100
LOG_LEVEL=info
